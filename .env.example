# ================================
# 数据库配置
# ================================
# PostgreSQL 用户名
POSTGRES_USER=yourusername
# PostgreSQL 密码
POSTGRES_PASSWORD=yourpassword
# PostgreSQL 数据库名
POSTGRES_DB=yourdatabase

# ================================
# Vapor 配置
# ================================
# 日志级别: trace, debug, info, notice, warning, error, critical
LOG_LEVEL=debug
# Vapor 数据库用户名（与 PostgreSQL 相同）
VAPOR_DATABASE_USERNAME=${POSTGRES_USER}
# Vapor 数据库密码（与 PostgreSQL 相同）
VAPOR_DATABASE_PASSWORD=${POSTGRES_PASSWORD}
# Vapor 数据库名（与 PostgreSQL 相同）
VAPOR_DATABASE_NAME=${POSTGRES_DB}

# ================================
# TLS 证书配置
# ================================
# 证书目录路径
SSL_CERT_DIR=./Docs/ssl
# TLS 证书路径（容器内路径）
TLS_CERT_PATH=/app/certs/cert.pem
# TLS 私钥路径（容器内路径）
TLS_KEY_PATH=/app/certs/key.pem

# ================================
# JWT 配置
# ================================
# JWT 密钥（用于令牌签名）
JWT_SECRET=your-jwt-secret

# ================================
# 腾讯云配置
# ================================
# 腾讯云 SecretId
TENCENT_SECRET_ID=your-secret-id
# 腾讯云 SecretKey
TENCENT_SECRET_KEY=your-secret-key
# 腾讯云地区
TENCENT_REGION=ap-beijing
# 腾讯云应用 ID
TENCENT_APP_ID=your-app-id

# ================================
# 大语言模型配置
# ================================
# 大模型提供者类型：tencent（腾讯）, deepseek（DeepSeek）, doubao（豆包）
LLM_PROVIDER=tencent
# 腾讯混元模型
TENCENT_MODEL=hunyuan-standard-256K

# ================================
# Prompt 配置
# ================================
# 默认 Prompt 文件路径
DEFAULT_PROMPT_PATH=./Resources/Prompts/default.md
# 默认 Prompt 版本
DEFAULT_PROMPT_VERSION=1

# --------- 腾讯混元配置 ---------
# 腾讯混元 API 密钥
TENCENT_HUNYUAN_API_KEY=sk-tencent-hunyuan-api-key

# --------- DeepSeek 配置 ---------
# DeepSeek API 密钥
DEEPSEEK_API_KEY=sk-deepseek-api-key

# --------- 豆包配置 ---------
# 豆包 API 密钥
DOUBAO_API_KEY=doubao-api-key

# ================================
# 服务器配置
# ================================
# 域名配置
DOMAIN=www.schedulesage.cn
# 服务端口配置
PORT=443

# RevenueCat Configuration
REVENUECAT_WEBHOOK_SECRET=your_webhook_secret_here
REVENUECAT_API_KEY=your_api_key_here

# 当未订阅时，是否启用高级功能, 默认是 false，可用于 App 初次上架推广
ENABLE_PREMIUM_FEATURES_WHEN_UNSUBSCRIBED=true
